{
  "name": "sen-bpmn",
  "version": "0.1.0",
  "private": true,
  "description": "Bibliothèque ouverte des processus hospitaliers sénégalais au format BPMN.",
  "license": "MIT",
  "homepage": "https://sen-bpmn.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanecode/sen-bpmn.git"
  },
  "bugs": {
    "url": "https://github.com/wanecode/sen-bpmn/issues"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:bpmn": "tsx scripts/generate-bpmn.ts",
    "check:bpmn": "tsx scripts/check-bpmn.ts",
    "test": "npm run check:bpmn",
    "verify": "npm run generate:bpmn && npm run check:bpmn && npm run lint && npm run build",
    "docker:build": "docker build -t sen-bpmn:local ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "^13.0.3",
    "bpmn-js": "^18.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "bpmn-moddle": "^9.0.4",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
