      <bpmndi:BPMNEdge id="Arete_Flux_10_orientation_apres_urgences" bpmnElement="Flux_10_orientation_apres_urgences"><di:waypoint x="1280" y="580" /><di:waypoint x="1300" y="580" /><di:waypoint x="1300" y="140" /><di:waypoint x="1320" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_11_orientation_apres_urgences" bpmnElement="Flux_11_orientation_apres_urgences"><di:waypoint x="1460" y="140" /><di:waypoint x="1480" y="140" /><di:waypoint x="1480" y="134" /><di:waypoint x="1500" y="134" /></bpmndi:BPMNEdge>
