      <bpmndi:BPMNEdge id="Arete_Association_liaison_orientation_apres_urgences" bpmnElement="Association_liaison_orientation_apres_urgences"><di:waypoint x="1278" y="653" /><di:waypoint x="1210" y="617" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
