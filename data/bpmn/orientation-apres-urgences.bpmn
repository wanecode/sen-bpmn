      <bpmndi:BPMNEdge id="Arete_Flux_2_orientation_apres_urgences" bpmnElement="Flux_2_orientation_apres_urgences"><di:waypoint x="380" y="140" /><di:waypoint x="400" y="140" /><di:waypoint x="400" y="133" /><di:waypoint x="420" y="133" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_3_orientation_apres_urgences" bpmnElement="Flux_3_orientation_apres_urgences"><di:waypoint x="470" y="133" /><di:waypoint x="535" y="133" /><di:waypoint x="535" y="360" /><di:waypoint x="600" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="88" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_4_orientation_apres_urgences" bpmnElement="Flux_4_orientation_apres_urgences"><di:waypoint x="470" y="133" /><di:waypoint x="535" y="133" /><di:waypoint x="535" y="581" /><di:waypoint x="600" y="581" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="88" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_5_orientation_apres_urgences" bpmnElement="Flux_5_orientation_apres_urgences"><di:waypoint x="740" y="360" /><di:waypoint x="760" y="360" /><di:waypoint x="760" y="354" /><di:waypoint x="780" y="354" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_6_orientation_apres_urgences" bpmnElement="Flux_6_orientation_apres_urgences"><di:waypoint x="816" y="354" /><di:waypoint x="978" y="354" /><di:waypoint x="978" y="580" /><di:waypoint x="1140" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_7_orientation_apres_urgences" bpmnElement="Flux_7_orientation_apres_urgences"><di:waypoint x="752" y="397" /><di:waypoint x="856" y="397" /><di:waypoint x="856" y="360" /><di:waypoint x="960" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="841" y="303" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
