    <bpmn:dataObjectReference id="Document_demande_imagerie_demande_imagerie_medicale" name="Demande d’imagerie" dataObjectRef="Objet_demande_imagerie_demande_imagerie_medicale" />
    <bpmn:association id="Association_demande_imagerie_demande_imagerie_medicale" sourceRef="Document_demande_imagerie_demande_imagerie_medicale" targetRef="pertinence_demande_imagerie_medicale" associationDirection="One" />
    <bpmn:dataObject id="Objet_cr_imagerie_demande_imagerie_medicale" />
