<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demande_imagerie_medicale" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_demande_imagerie_medicale" name="Message métier" />
  <bpmn:error id="Erreur_demande_imagerie_medicale" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_demande_imagerie_medicale" name="Demande d’imagerie médicale" isExecutable="false">
    <bpmn:documentation>Planifier l’examen, vérifier les contre-indications et transmettre un compte rendu interprété. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_demande_imagerie_medicale">
      <bpmn:lane id="Couloir_1_demande_imagerie_medicale" name="Médecin prescripteur">
        <bpmn:flowNodeRef>debut_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adapter_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alerte_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_demande_imagerie_medicale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_demande_imagerie_medicale" name="Manipulateur d’imagerie">
        <bpmn:flowNodeRef>precautions_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contreindication_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planifier_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>realiser_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>panne_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reprogrammer_demande_imagerie_medicale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_demande_imagerie_medicale" name="Radiologue">
        <bpmn:flowNodeRef>pertinence_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interpreter_demande_imagerie_medicale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>urgent_demande_imagerie_medicale</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_demande_imagerie_medicale" name="Demande d’imagerie reçue">
      <bpmn:outgoing>Flux_1_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="pertinence_demande_imagerie_medicale" name="Vérifier indication et urgence">
      <bpmn:incoming>Flux_1_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_2_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="precautions_demande_imagerie_medicale" name="Vérifier identité et contre-indications">
      <bpmn:incoming>Flux_2_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_3_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_precautions_demande_imagerie_medicale"><bpmn:outgoing>Flux_interne_1_precautions_demande_imagerie_medicale</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_precautions_demande_imagerie_medicale" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_precautions_demande_imagerie_medicale</bpmn:incoming><bpmn:outgoing>Flux_interne_2_precautions_demande_imagerie_medicale</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_precautions_demande_imagerie_medicale"><bpmn:incoming>Flux_interne_2_precautions_demande_imagerie_medicale</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_precautions_demande_imagerie_medicale" sourceRef="Debut_interne_precautions_demande_imagerie_medicale" targetRef="Etapes_internes_precautions_demande_imagerie_medicale" />
      <bpmn:sequenceFlow id="Flux_interne_2_precautions_demande_imagerie_medicale" sourceRef="Etapes_internes_precautions_demande_imagerie_medicale" targetRef="Fin_interne_precautions_demande_imagerie_medicale" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="contreindication_demande_imagerie_medicale" name="Contre-indication détectée" attachedToRef="precautions_demande_imagerie_medicale" cancelActivity="true">
      <bpmn:outgoing>Flux_4_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_contreindication_demande_imagerie_medicale" errorRef="Erreur_demande_imagerie_medicale" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="adapter_demande_imagerie_medicale" name="Contacter le prescripteur et adapter">
      <bpmn:incoming>Flux_4_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_5_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="planifier_demande_imagerie_medicale" name="Planifier et préparer l’examen">
      <bpmn:incoming>Flux_3_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:incoming>Flux_5_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_6_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="realiser_demande_imagerie_medicale" name="Acquérir les images">
      <bpmn:incoming>Flux_6_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_9_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:boundaryEvent id="panne_demande_imagerie_medicale" name="Panne ou examen interrompu" attachedToRef="realiser_demande_imagerie_medicale" cancelActivity="true">
      <bpmn:outgoing>Flux_7_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_panne_demande_imagerie_medicale" errorRef="Erreur_demande_imagerie_medicale" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="reprogrammer_demande_imagerie_medicale" name="Sécuriser et reprogrammer">
      <bpmn:incoming>Flux_7_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_8_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="interpreter_demande_imagerie_medicale" name="Interpréter et valider le compte rendu">
      <bpmn:incoming>Flux_9_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_10_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_interpreter_demande_imagerie_medicale"><bpmn:outgoing>Flux_interne_1_interpreter_demande_imagerie_medicale</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_interpreter_demande_imagerie_medicale" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_interpreter_demande_imagerie_medicale</bpmn:incoming><bpmn:outgoing>Flux_interne_2_interpreter_demande_imagerie_medicale</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_interpreter_demande_imagerie_medicale"><bpmn:incoming>Flux_interne_2_interpreter_demande_imagerie_medicale</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_interpreter_demande_imagerie_medicale" sourceRef="Debut_interne_interpreter_demande_imagerie_medicale" targetRef="Etapes_internes_interpreter_demande_imagerie_medicale" />
      <bpmn:sequenceFlow id="Flux_interne_2_interpreter_demande_imagerie_medicale" sourceRef="Etapes_internes_interpreter_demande_imagerie_medicale" targetRef="Fin_interne_interpreter_demande_imagerie_medicale" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="urgent_demande_imagerie_medicale" name="Anomalie urgente ?">
      <bpmn:incoming>Flux_10_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_11_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:outgoing>Flux_12_demande_imagerie_medicale</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="alerte_demande_imagerie_medicale" name="Prescripteur alerté">
      <bpmn:incoming>Flux_11_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:outgoing>Flux_13_demande_imagerie_medicale</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_alerte_demande_imagerie_medicale" messageRef="Message_demande_imagerie_medicale" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="fin_demande_imagerie_medicale" name="Résultat disponible">
      <bpmn:incoming>Flux_8_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:incoming>Flux_12_demande_imagerie_medicale</bpmn:incoming>
      <bpmn:incoming>Flux_13_demande_imagerie_medicale</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_demande_imagerie_medicale" sourceRef="debut_demande_imagerie_medicale" targetRef="pertinence_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_2_demande_imagerie_medicale" sourceRef="pertinence_demande_imagerie_medicale" targetRef="precautions_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_3_demande_imagerie_medicale" sourceRef="precautions_demande_imagerie_medicale" targetRef="planifier_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_4_demande_imagerie_medicale" name="Exception" sourceRef="contreindication_demande_imagerie_medicale" targetRef="adapter_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_5_demande_imagerie_medicale" sourceRef="adapter_demande_imagerie_medicale" targetRef="planifier_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_6_demande_imagerie_medicale" sourceRef="planifier_demande_imagerie_medicale" targetRef="realiser_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_7_demande_imagerie_medicale" name="Exception" sourceRef="panne_demande_imagerie_medicale" targetRef="reprogrammer_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_8_demande_imagerie_medicale" sourceRef="reprogrammer_demande_imagerie_medicale" targetRef="fin_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_9_demande_imagerie_medicale" sourceRef="realiser_demande_imagerie_medicale" targetRef="interpreter_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_10_demande_imagerie_medicale" sourceRef="interpreter_demande_imagerie_medicale" targetRef="urgent_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_11_demande_imagerie_medicale" name="Oui" sourceRef="urgent_demande_imagerie_medicale" targetRef="alerte_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_12_demande_imagerie_medicale" name="Non" sourceRef="urgent_demande_imagerie_medicale" targetRef="fin_demande_imagerie_medicale" />
    <bpmn:sequenceFlow id="Flux_13_demande_imagerie_medicale" sourceRef="alerte_demande_imagerie_medicale" targetRef="fin_demande_imagerie_medicale" />
