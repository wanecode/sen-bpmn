<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_urgence_obstetricale" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_urgence_obstetricale" name="Message métier" />
  <bpmn:error id="Erreur_urgence_obstetricale" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_urgence_obstetricale" name="Prise en charge d’une urgence obstétricale" isExecutable="false">
    <bpmn:documentation>Mobiliser sans délai l’équipe et les moyens requis face à une complication maternelle ou fœtale grave. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_urgence_obstetricale">
      <bpmn:lane id="Couloir_1_urgence_obstetricale" name="Sage-femme de garde">
        <bpmn:flowNodeRef>debut_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alerte_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluer_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>surveillance_urgence_obstetricale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_urgence_obstetricale" name="Équipe obstétricale / bloc">
        <bpmn:flowNodeRef>equipe_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extraction_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloc_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>indispo_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_urgence_obstetricale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_urgence_obstetricale" name="Réanimation et banque de sang">
        <bpmn:flowNodeRef>stabiliser_urgence_obstetricale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transfert_urgence_obstetricale</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_urgence_obstetricale" name="Urgence obstétricale reconnue">
      <bpmn:outgoing>Flux_1_urgence_obstetricale</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="alerte_urgence_obstetricale" name="Déclencher l’alerte obstétricale">
      <bpmn:incoming>Flux_1_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_2_urgence_obstetricale</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="equipe_urgence_obstetricale" name="Équipe mobilisée">
      <bpmn:incoming>Flux_2_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_3_urgence_obstetricale</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_equipe_urgence_obstetricale" messageRef="Message_urgence_obstetricale" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="split_urgence_obstetricale" name="Réponse immédiate">
      <bpmn:incoming>Flux_3_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_4_urgence_obstetricale</bpmn:outgoing>
      <bpmn:outgoing>Flux_5_urgence_obstetricale</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="evaluer_urgence_obstetricale" name="Évaluer la mère et le fœtus">
      <bpmn:incoming>Flux_4_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_6_urgence_obstetricale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="stabiliser_urgence_obstetricale" name="Stabiliser et préparer les produits">
      <bpmn:incoming>Flux_5_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_7_urgence_obstetricale</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_stabiliser_urgence_obstetricale"><bpmn:outgoing>Flux_interne_1_stabiliser_urgence_obstetricale</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_stabiliser_urgence_obstetricale" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_stabiliser_urgence_obstetricale</bpmn:incoming><bpmn:outgoing>Flux_interne_2_stabiliser_urgence_obstetricale</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_stabiliser_urgence_obstetricale"><bpmn:incoming>Flux_interne_2_stabiliser_urgence_obstetricale</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_stabiliser_urgence_obstetricale" sourceRef="Debut_interne_stabiliser_urgence_obstetricale" targetRef="Etapes_internes_stabiliser_urgence_obstetricale" />
      <bpmn:sequenceFlow id="Flux_interne_2_stabiliser_urgence_obstetricale" sourceRef="Etapes_internes_stabiliser_urgence_obstetricale" targetRef="Fin_interne_stabiliser_urgence_obstetricale" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="merge_urgence_obstetricale" name="Décision obstétricale">
      <bpmn:incoming>Flux_6_urgence_obstetricale</bpmn:incoming>
      <bpmn:incoming>Flux_7_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_8_urgence_obstetricale</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="extraction_urgence_obstetricale" name="Extraction urgente ?">
      <bpmn:incoming>Flux_8_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_9_urgence_obstetricale</bpmn:outgoing>
      <bpmn:outgoing>Flux_10_urgence_obstetricale</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="bloc_urgence_obstetricale" name="Activer et préparer le bloc">
      <bpmn:incoming>Flux_9_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_12_urgence_obstetricale</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_bloc_urgence_obstetricale"><bpmn:outgoing>Flux_interne_1_bloc_urgence_obstetricale</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_bloc_urgence_obstetricale" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_bloc_urgence_obstetricale</bpmn:incoming><bpmn:outgoing>Flux_interne_2_bloc_urgence_obstetricale</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_bloc_urgence_obstetricale"><bpmn:incoming>Flux_interne_2_bloc_urgence_obstetricale</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_bloc_urgence_obstetricale" sourceRef="Debut_interne_bloc_urgence_obstetricale" targetRef="Etapes_internes_bloc_urgence_obstetricale" />
      <bpmn:sequenceFlow id="Flux_interne_2_bloc_urgence_obstetricale" sourceRef="Etapes_internes_bloc_urgence_obstetricale" targetRef="Fin_interne_bloc_urgence_obstetricale" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="indispo_urgence_obstetricale" name="Bloc indisponible" attachedToRef="bloc_urgence_obstetricale" cancelActivity="true">
      <bpmn:outgoing>Flux_11_urgence_obstetricale</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_temps_indispo_urgence_obstetricale" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="transfert_urgence_obstetricale" name="Organiser un transfert médicalisé">
      <bpmn:incoming>Flux_11_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_13_urgence_obstetricale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="surveillance_urgence_obstetricale" name="Poursuivre la surveillance renforcée">
      <bpmn:incoming>Flux_10_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_14_urgence_obstetricale</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="post_urgence_obstetricale" name="Assurer le suivi post-intervention">
      <bpmn:incoming>Flux_12_urgence_obstetricale</bpmn:incoming>
      <bpmn:incoming>Flux_13_urgence_obstetricale</bpmn:incoming>
      <bpmn:incoming>Flux_14_urgence_obstetricale</bpmn:incoming>
      <bpmn:outgoing>Flux_15_urgence_obstetricale</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_post_urgence_obstetricale"><bpmn:outgoing>Flux_interne_1_post_urgence_obstetricale</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_post_urgence_obstetricale" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_post_urgence_obstetricale</bpmn:incoming><bpmn:outgoing>Flux_interne_2_post_urgence_obstetricale</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_post_urgence_obstetricale"><bpmn:incoming>Flux_interne_2_post_urgence_obstetricale</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_post_urgence_obstetricale" sourceRef="Debut_interne_post_urgence_obstetricale" targetRef="Etapes_internes_post_urgence_obstetricale" />
      <bpmn:sequenceFlow id="Flux_interne_2_post_urgence_obstetricale" sourceRef="Etapes_internes_post_urgence_obstetricale" targetRef="Fin_interne_post_urgence_obstetricale" />
    </bpmn:subProcess>
    <bpmn:endEvent id="fin_urgence_obstetricale" name="Relais obstétrical assuré">
      <bpmn:incoming>Flux_15_urgence_obstetricale</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_urgence_obstetricale" sourceRef="debut_urgence_obstetricale" targetRef="alerte_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_2_urgence_obstetricale" sourceRef="alerte_urgence_obstetricale" targetRef="equipe_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_3_urgence_obstetricale" sourceRef="equipe_urgence_obstetricale" targetRef="split_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_4_urgence_obstetricale" sourceRef="split_urgence_obstetricale" targetRef="evaluer_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_5_urgence_obstetricale" sourceRef="split_urgence_obstetricale" targetRef="stabiliser_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_6_urgence_obstetricale" sourceRef="evaluer_urgence_obstetricale" targetRef="merge_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_7_urgence_obstetricale" sourceRef="stabiliser_urgence_obstetricale" targetRef="merge_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_8_urgence_obstetricale" sourceRef="merge_urgence_obstetricale" targetRef="extraction_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_9_urgence_obstetricale" name="Oui" sourceRef="extraction_urgence_obstetricale" targetRef="bloc_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_10_urgence_obstetricale" name="Non" sourceRef="extraction_urgence_obstetricale" targetRef="surveillance_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_11_urgence_obstetricale" name="Exception" sourceRef="indispo_urgence_obstetricale" targetRef="transfert_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_12_urgence_obstetricale" sourceRef="bloc_urgence_obstetricale" targetRef="post_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_13_urgence_obstetricale" sourceRef="transfert_urgence_obstetricale" targetRef="post_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_14_urgence_obstetricale" sourceRef="surveillance_urgence_obstetricale" targetRef="post_urgence_obstetricale" />
    <bpmn:sequenceFlow id="Flux_15_urgence_obstetricale" sourceRef="post_urgence_obstetricale" targetRef="fin_urgence_obstetricale" />
    <bpmn:dataObject id="Objet_checklist_obst_urgence_obstetricale" />
    <bpmn:dataObjectReference id="Document_checklist_obst_urgence_obstetricale" name="Checklist d’urgence obstétricale" dataObjectRef="Objet_checklist_obst_urgence_obstetricale" />
    <bpmn:association id="Association_checklist_obst_urgence_obstetricale" sourceRef="Document_checklist_obst_urgence_obstetricale" targetRef="evaluer_urgence_obstetricale" associationDirection="One" />
  </bpmn:process>
