<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_prescription_medicament" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_prescription_medicament" name="Message métier" />
  <bpmn:error id="Erreur_prescription_medicament" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_prescription_medicament" name="Prescription d’un médicament" isExecutable="false">
    <bpmn:documentation>Sécuriser le choix, la posologie et la traçabilité d’un traitement médicamenteux. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_prescription_medicament">
      <bpmn:lane id="Couloir_1_prescription_medicament" name="Médecin prescripteur">
        <bpmn:flowNodeRef>debut_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluer_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choisir_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prescrire_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarifier_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modifier_prescription_medicament</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_prescription_medicament" name="Pharmacien">
        <bpmn:flowNodeRef>analyse_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interaction_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valide_prescription_medicament</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_prescription_medicament" name="Patient / équipe soignante">
        <bpmn:flowNodeRef>informer_prescription_medicament</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_prescription_medicament</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_prescription_medicament" name="Indication thérapeutique posée">
      <bpmn:outgoing>Flux_1_prescription_medicament</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="evaluer_prescription_medicament" name="Évaluer patient, allergies et traitement">
      <bpmn:incoming>Flux_1_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_2_prescription_medicament</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_evaluer_prescription_medicament"><bpmn:outgoing>Flux_interne_1_evaluer_prescription_medicament</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_evaluer_prescription_medicament" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_evaluer_prescription_medicament</bpmn:incoming><bpmn:outgoing>Flux_interne_2_evaluer_prescription_medicament</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_evaluer_prescription_medicament"><bpmn:incoming>Flux_interne_2_evaluer_prescription_medicament</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_evaluer_prescription_medicament" sourceRef="Debut_interne_evaluer_prescription_medicament" targetRef="Etapes_internes_evaluer_prescription_medicament" />
      <bpmn:sequenceFlow id="Flux_interne_2_evaluer_prescription_medicament" sourceRef="Etapes_internes_evaluer_prescription_medicament" targetRef="Fin_interne_evaluer_prescription_medicament" />
    </bpmn:subProcess>
    <bpmn:userTask id="choisir_prescription_medicament" name="Choisir molécule, dose et durée">
      <bpmn:incoming>Flux_2_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_3_prescription_medicament</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="prescrire_prescription_medicament" name="Émettre la prescription complète">
      <bpmn:incoming>Flux_3_prescription_medicament</bpmn:incoming>
      <bpmn:incoming>Flux_9_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_4_prescription_medicament</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="analyse_prescription_medicament" name="Réaliser l’analyse pharmaceutique">
      <bpmn:incoming>Flux_4_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_5_prescription_medicament</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_analyse_prescription_medicament"><bpmn:outgoing>Flux_interne_1_analyse_prescription_medicament</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_analyse_prescription_medicament" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_analyse_prescription_medicament</bpmn:incoming><bpmn:outgoing>Flux_interne_2_analyse_prescription_medicament</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_analyse_prescription_medicament"><bpmn:incoming>Flux_interne_2_analyse_prescription_medicament</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_analyse_prescription_medicament" sourceRef="Debut_interne_analyse_prescription_medicament" targetRef="Etapes_internes_analyse_prescription_medicament" />
      <bpmn:sequenceFlow id="Flux_interne_2_analyse_prescription_medicament" sourceRef="Etapes_internes_analyse_prescription_medicament" targetRef="Fin_interne_analyse_prescription_medicament" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="interaction_prescription_medicament" name="Interaction ou dose à risque" attachedToRef="analyse_prescription_medicament" cancelActivity="true">
      <bpmn:outgoing>Flux_6_prescription_medicament</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_interaction_prescription_medicament" errorRef="Erreur_prescription_medicament" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="clarifier_prescription_medicament" name="Clarification avec le prescripteur">
      <bpmn:incoming>Flux_6_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_7_prescription_medicament</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_clarifier_prescription_medicament" messageRef="Message_prescription_medicament" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="valide_prescription_medicament" name="Prescription validée ?">
      <bpmn:incoming>Flux_5_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_8_prescription_medicament</bpmn:outgoing>
      <bpmn:outgoing>Flux_10_prescription_medicament</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="modifier_prescription_medicament" name="Modifier la prescription">
      <bpmn:incoming>Flux_7_prescription_medicament</bpmn:incoming>
      <bpmn:incoming>Flux_8_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_9_prescription_medicament</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="informer_prescription_medicament" name="Informer le patient ou le soignant">
      <bpmn:incoming>Flux_10_prescription_medicament</bpmn:incoming>
      <bpmn:outgoing>Flux_11_prescription_medicament</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fin_prescription_medicament" name="Prescription transmise">
      <bpmn:incoming>Flux_11_prescription_medicament</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_prescription_medicament" sourceRef="debut_prescription_medicament" targetRef="evaluer_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_2_prescription_medicament" sourceRef="evaluer_prescription_medicament" targetRef="choisir_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_3_prescription_medicament" sourceRef="choisir_prescription_medicament" targetRef="prescrire_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_4_prescription_medicament" sourceRef="prescrire_prescription_medicament" targetRef="analyse_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_5_prescription_medicament" sourceRef="analyse_prescription_medicament" targetRef="valide_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_6_prescription_medicament" name="Exception" sourceRef="interaction_prescription_medicament" targetRef="clarifier_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_7_prescription_medicament" sourceRef="clarifier_prescription_medicament" targetRef="modifier_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_8_prescription_medicament" name="Non" sourceRef="valide_prescription_medicament" targetRef="modifier_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_9_prescription_medicament" sourceRef="modifier_prescription_medicament" targetRef="prescrire_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_10_prescription_medicament" name="Oui" sourceRef="valide_prescription_medicament" targetRef="informer_prescription_medicament" />
    <bpmn:sequenceFlow id="Flux_11_prescription_medicament" sourceRef="informer_prescription_medicament" targetRef="fin_prescription_medicament" />
    <bpmn:dataObject id="Objet_ordonnance_prescription_medicament" />
    <bpmn:dataObjectReference id="Document_ordonnance_prescription_medicament" name="Prescription médicamenteuse" dataObjectRef="Objet_ordonnance_prescription_medicament" />
    <bpmn:association id="Association_ordonnance_prescription_medicament" sourceRef="Document_ordonnance_prescription_medicament" targetRef="prescrire_prescription_medicament" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagramme_prescription_medicament">
    <bpmndi:BPMNPlane id="Plan_prescription_medicament" bpmnElement="Processus_prescription_medicament">
      <bpmndi:BPMNShape id="Forme_Couloir_1_prescription_medicament" bpmnElement="Couloir_1_prescription_medicament" isHorizontal="true"><dc:Bounds x="20" y="30" width="1810" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_Couloir_2_prescription_medicament" bpmnElement="Couloir_2_prescription_medicament" isHorizontal="true"><dc:Bounds x="20" y="250" width="1810" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_Couloir_3_prescription_medicament" bpmnElement="Couloir_3_prescription_medicament" isHorizontal="true"><dc:Bounds x="20" y="470" width="1810" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_debut_prescription_medicament" bpmnElement="debut_prescription_medicament"><dc:Bounds x="60" y="116" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_evaluer_prescription_medicament" bpmnElement="evaluer_prescription_medicament" isExpanded="false"><dc:Bounds x="240" y="98" width="150" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_choisir_prescription_medicament" bpmnElement="choisir_prescription_medicament"><dc:Bounds x="420" y="103" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_prescrire_prescription_medicament" bpmnElement="prescrire_prescription_medicament"><dc:Bounds x="600" y="103" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_analyse_prescription_medicament" bpmnElement="analyse_prescription_medicament" isExpanded="false"><dc:Bounds x="780" y="318" width="150" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_interaction_prescription_medicament" bpmnElement="interaction_prescription_medicament"><dc:Bounds x="912" y="389" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_clarifier_prescription_medicament" bpmnElement="clarifier_prescription_medicament"><dc:Bounds x="960" y="116" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_valide_prescription_medicament" bpmnElement="valide_prescription_medicament" isMarkerVisible="true"><dc:Bounds x="1140" y="328" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_modifier_prescription_medicament" bpmnElement="modifier_prescription_medicament"><dc:Bounds x="1320" y="103" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_informer_prescription_medicament" bpmnElement="informer_prescription_medicament"><dc:Bounds x="1320" y="543" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_fin_prescription_medicament" bpmnElement="fin_prescription_medicament"><dc:Bounds x="1500" y="556" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_Document_ordonnance_prescription_medicament" bpmnElement="Document_ordonnance_prescription_medicament"><dc:Bounds x="720" y="189" width="36" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Arete_Flux_1_prescription_medicament" bpmnElement="Flux_1_prescription_medicament"><di:waypoint x="96" y="134" /><di:waypoint x="168" y="134" /><di:waypoint x="168" y="141" /><di:waypoint x="240" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_2_prescription_medicament" bpmnElement="Flux_2_prescription_medicament"><di:waypoint x="390" y="141" /><di:waypoint x="420" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_3_prescription_medicament" bpmnElement="Flux_3_prescription_medicament"><di:waypoint x="560" y="140" /><di:waypoint x="600" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_4_prescription_medicament" bpmnElement="Flux_4_prescription_medicament"><di:waypoint x="740" y="140" /><di:waypoint x="760" y="140" /><di:waypoint x="760" y="361" /><di:waypoint x="780" y="361" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_5_prescription_medicament" bpmnElement="Flux_5_prescription_medicament"><di:waypoint x="930" y="361" /><di:waypoint x="1035" y="361" /><di:waypoint x="1035" y="353" /><di:waypoint x="1140" y="353" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_6_prescription_medicament" bpmnElement="Flux_6_prescription_medicament"><di:waypoint x="942" y="404" /><di:waypoint x="951" y="404" /><di:waypoint x="951" y="134" /><di:waypoint x="960" y="134" /><bpmndi:BPMNLabel><dc:Bounds x="936" y="96" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_7_prescription_medicament" bpmnElement="Flux_7_prescription_medicament"><di:waypoint x="996" y="134" /><di:waypoint x="1158" y="134" /><di:waypoint x="1158" y="140" /><di:waypoint x="1320" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_8_prescription_medicament" bpmnElement="Flux_8_prescription_medicament"><di:waypoint x="1190" y="353" /><di:waypoint x="1255" y="353" /><di:waypoint x="1255" y="140" /><di:waypoint x="1320" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="1230" y="83" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_9_prescription_medicament" bpmnElement="Flux_9_prescription_medicament"><di:waypoint x="1460" y="140" /><di:waypoint x="1488" y="140" /><di:waypoint x="1488" y="211" /><di:waypoint x="572" y="211" /><di:waypoint x="572" y="140" /><di:waypoint x="600" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_10_prescription_medicament" bpmnElement="Flux_10_prescription_medicament"><di:waypoint x="1190" y="353" /><di:waypoint x="1255" y="353" /><di:waypoint x="1255" y="580" /><di:waypoint x="1320" y="580" /><bpmndi:BPMNLabel><dc:Bounds x="1230" y="308" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_11_prescription_medicament" bpmnElement="Flux_11_prescription_medicament"><di:waypoint x="1460" y="580" /><di:waypoint x="1480" y="580" /><di:waypoint x="1480" y="574" /><di:waypoint x="1500" y="574" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Association_ordonnance_prescription_medicament" bpmnElement="Association_ordonnance_prescription_medicament"><di:waypoint x="738" y="213" /><di:waypoint x="670" y="177" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
