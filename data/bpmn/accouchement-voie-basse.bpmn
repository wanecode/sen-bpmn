<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_accouchement_voie_basse" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_accouchement_voie_basse" name="Message métier" />
  <bpmn:error id="Erreur_accouchement_voie_basse" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_accouchement_voie_basse" name="Accouchement par voie basse" isExecutable="false">
    <bpmn:documentation>Décrire la surveillance du travail, la naissance, les soins immédiats et la prévention des complications. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_accouchement_voie_basse">
      <bpmn:lane id="Couloir_1_accouchement_voie_basse" name="Sage-femme">
        <bpmn:flowNodeRef>debut_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>admettre_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>surveiller_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anomalie_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complet_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>naissance_accouchement_voie_basse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_accouchement_voie_basse" name="Équipe obstétricale">
        <bpmn:flowNodeRef>alerte_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mere_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_accouchement_voie_basse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_accouchement_voie_basse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_accouchement_voie_basse" name="Équipe nouveau-né">
        <bpmn:flowNodeRef>nouveau_ne_accouchement_voie_basse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_accouchement_voie_basse" name="Travail confirmé">
      <bpmn:outgoing>Flux_1_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="admettre_accouchement_voie_basse" name="Admettre et évaluer le risque">
      <bpmn:incoming>Flux_1_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_2_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="surveiller_accouchement_voie_basse" name="Surveiller le travail au partogramme">
      <bpmn:incoming>Flux_2_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_3_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_surveiller_accouchement_voie_basse"><bpmn:outgoing>Flux_interne_1_surveiller_accouchement_voie_basse</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_surveiller_accouchement_voie_basse" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_surveiller_accouchement_voie_basse</bpmn:incoming><bpmn:outgoing>Flux_interne_2_surveiller_accouchement_voie_basse</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_surveiller_accouchement_voie_basse"><bpmn:incoming>Flux_interne_2_surveiller_accouchement_voie_basse</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_surveiller_accouchement_voie_basse" sourceRef="Debut_interne_surveiller_accouchement_voie_basse" targetRef="Etapes_internes_surveiller_accouchement_voie_basse" />
      <bpmn:sequenceFlow id="Flux_interne_2_surveiller_accouchement_voie_basse" sourceRef="Etapes_internes_surveiller_accouchement_voie_basse" targetRef="Fin_interne_surveiller_accouchement_voie_basse" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="anomalie_accouchement_voie_basse" name="Anomalie maternelle ou fœtale" attachedToRef="surveiller_accouchement_voie_basse" cancelActivity="true">
      <bpmn:outgoing>Flux_4_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_anomalie_accouchement_voie_basse" errorRef="Erreur_accouchement_voie_basse" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="alerte_accouchement_voie_basse" name="Activer l’urgence obstétricale">
      <bpmn:incoming>Flux_4_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_5_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_alerte_accouchement_voie_basse"><bpmn:outgoing>Flux_interne_1_alerte_accouchement_voie_basse</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_alerte_accouchement_voie_basse" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_alerte_accouchement_voie_basse</bpmn:incoming><bpmn:outgoing>Flux_interne_2_alerte_accouchement_voie_basse</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_alerte_accouchement_voie_basse"><bpmn:incoming>Flux_interne_2_alerte_accouchement_voie_basse</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_alerte_accouchement_voie_basse" sourceRef="Debut_interne_alerte_accouchement_voie_basse" targetRef="Etapes_internes_alerte_accouchement_voie_basse" />
      <bpmn:sequenceFlow id="Flux_interne_2_alerte_accouchement_voie_basse" sourceRef="Etapes_internes_alerte_accouchement_voie_basse" targetRef="Fin_interne_alerte_accouchement_voie_basse" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="complet_accouchement_voie_basse" name="Dilatation complète">
      <bpmn:incoming>Flux_3_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_6_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_temps_complet_accouchement_voie_basse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="naissance_accouchement_voie_basse" name="Accompagner l’expulsion et la naissance">
      <bpmn:incoming>Flux_6_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_7_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="split_accouchement_voie_basse" name="Soins immédiats">
      <bpmn:incoming>Flux_7_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_8_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:outgoing>Flux_9_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="mere_accouchement_voie_basse" name="Surveiller délivrance et post-partum">
      <bpmn:incoming>Flux_8_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_10_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="nouveau_ne_accouchement_voie_basse" name="Réaliser les soins du nouveau-né">
      <bpmn:incoming>Flux_9_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_11_accouchement_voie_basse</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_nouveau_ne_accouchement_voie_basse"><bpmn:outgoing>Flux_interne_1_nouveau_ne_accouchement_voie_basse</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_nouveau_ne_accouchement_voie_basse" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_nouveau_ne_accouchement_voie_basse</bpmn:incoming><bpmn:outgoing>Flux_interne_2_nouveau_ne_accouchement_voie_basse</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_nouveau_ne_accouchement_voie_basse"><bpmn:incoming>Flux_interne_2_nouveau_ne_accouchement_voie_basse</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_nouveau_ne_accouchement_voie_basse" sourceRef="Debut_interne_nouveau_ne_accouchement_voie_basse" targetRef="Etapes_internes_nouveau_ne_accouchement_voie_basse" />
      <bpmn:sequenceFlow id="Flux_interne_2_nouveau_ne_accouchement_voie_basse" sourceRef="Etapes_internes_nouveau_ne_accouchement_voie_basse" targetRef="Fin_interne_nouveau_ne_accouchement_voie_basse" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="merge_accouchement_voie_basse" name="Mère et enfant stables">
      <bpmn:incoming>Flux_10_accouchement_voie_basse</bpmn:incoming>
      <bpmn:incoming>Flux_11_accouchement_voie_basse</bpmn:incoming>
      <bpmn:outgoing>Flux_12_accouchement_voie_basse</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="fin_accouchement_voie_basse" name="Surveillance post-partum engagée">
      <bpmn:incoming>Flux_5_accouchement_voie_basse</bpmn:incoming>
      <bpmn:incoming>Flux_12_accouchement_voie_basse</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_accouchement_voie_basse" sourceRef="debut_accouchement_voie_basse" targetRef="admettre_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_2_accouchement_voie_basse" sourceRef="admettre_accouchement_voie_basse" targetRef="surveiller_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_3_accouchement_voie_basse" sourceRef="surveiller_accouchement_voie_basse" targetRef="complet_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_4_accouchement_voie_basse" name="Exception" sourceRef="anomalie_accouchement_voie_basse" targetRef="alerte_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_5_accouchement_voie_basse" sourceRef="alerte_accouchement_voie_basse" targetRef="fin_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_6_accouchement_voie_basse" sourceRef="complet_accouchement_voie_basse" targetRef="naissance_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_7_accouchement_voie_basse" sourceRef="naissance_accouchement_voie_basse" targetRef="split_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_8_accouchement_voie_basse" sourceRef="split_accouchement_voie_basse" targetRef="mere_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_9_accouchement_voie_basse" sourceRef="split_accouchement_voie_basse" targetRef="nouveau_ne_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_10_accouchement_voie_basse" sourceRef="mere_accouchement_voie_basse" targetRef="merge_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_11_accouchement_voie_basse" sourceRef="nouveau_ne_accouchement_voie_basse" targetRef="merge_accouchement_voie_basse" />
    <bpmn:sequenceFlow id="Flux_12_accouchement_voie_basse" sourceRef="merge_accouchement_voie_basse" targetRef="fin_accouchement_voie_basse" />
    <bpmn:dataObject id="Objet_partogramme_accouchement_voie_basse" />
    <bpmn:dataObjectReference id="Document_partogramme_accouchement_voie_basse" name="Partogramme" dataObjectRef="Objet_partogramme_accouchement_voie_basse" />
    <bpmn:association id="Association_partogramme_accouchement_voie_basse" sourceRef="Document_partogramme_accouchement_voie_basse" targetRef="surveiller_accouchement_voie_basse" associationDirection="One" />
    <bpmn:dataObject id="Objet_registre_accouchement_voie_basse" />
    <bpmn:dataObjectReference id="Document_registre_accouchement_voie_basse" name="Registre d’accouchement" dataObjectRef="Objet_registre_accouchement_voie_basse" />
    <bpmn:association id="Association_registre_accouchement_voie_basse" sourceRef="Document_registre_accouchement_voie_basse" targetRef="naissance_accouchement_voie_basse" associationDirection="One" />
  </bpmn:process>
