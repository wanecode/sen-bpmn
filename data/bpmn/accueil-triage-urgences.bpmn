      <bpmndi:BPMNShape id="Forme_Couloir_2_accueil_triage_urgences" bpmnElement="Couloir_2_accueil_triage_urgences" isHorizontal="true"><dc:Bounds x="20" y="250" width="1810" height="220" /></bpmndi:BPMNShape>
