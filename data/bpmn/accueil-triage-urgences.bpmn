      <bpmndi:BPMNShape id="Forme_Document_fiche_triage_accueil_triage_urgences" bpmnElement="Document_fiche_triage_accueil_triage_urgences"><dc:Bounds x="730" y="412" width="36" height="48" /></bpmndi:BPMNShape>
