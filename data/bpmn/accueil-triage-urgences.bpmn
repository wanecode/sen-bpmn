<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_accueil_triage_urgences" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_accueil_triage_urgences" name="Message métier" />
  <bpmn:error id="Erreur_accueil_triage_urgences" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_accueil_triage_urgences" name="Accueil et triage aux urgences" isExecutable="false">
    <bpmn:documentation>Évaluer rapidement la gravité, attribuer une priorité et orienter le patient vers la zone de soins adaptée. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_accueil_triage_urgences">
      <bpmn:lane id="Couloir_1_accueil_triage_urgences" name="Agent d’accueil">
        <bpmn:flowNodeRef>debut_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enregistrer_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identite_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provisoire_accueil_triage_urgences</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_accueil_triage_urgences" name="Infirmier organisateur de l’accueil">
        <bpmn:flowNodeRef>constantes_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>triage_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gravite_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orienter_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attente_accueil_triage_urgences</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_accueil_triage_urgences" name="Médecin urgentiste">
        <bpmn:flowNodeRef>alerte_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmettre_accueil_triage_urgences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_accueil_triage_urgences</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_accueil_triage_urgences" name="Patient arrivé">
      <bpmn:outgoing>Flux_1_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="enregistrer_accueil_triage_urgences" name="Enregistrer l’arrivée">
      <bpmn:incoming>Flux_1_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_2_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="identite_accueil_triage_urgences" name="Identité incertaine" attachedToRef="enregistrer_accueil_triage_urgences" cancelActivity="true">
      <bpmn:outgoing>Flux_3_accueil_triage_urgences</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_identite_accueil_triage_urgences" errorRef="Erreur_accueil_triage_urgences" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="provisoire_accueil_triage_urgences" name="Créer une identité provisoire">
      <bpmn:incoming>Flux_3_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_4_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="constantes_accueil_triage_urgences" name="Recueillir motif et constantes">
      <bpmn:incoming>Flux_2_accueil_triage_urgences</bpmn:incoming>
      <bpmn:incoming>Flux_4_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_5_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="triage_accueil_triage_urgences" name="Appliquer le protocole de triage">
      <bpmn:incoming>Flux_5_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_6_accueil_triage_urgences</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_triage_accueil_triage_urgences"><bpmn:outgoing>Flux_interne_1_triage_accueil_triage_urgences</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_triage_accueil_triage_urgences" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_triage_accueil_triage_urgences</bpmn:incoming><bpmn:outgoing>Flux_interne_2_triage_accueil_triage_urgences</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_triage_accueil_triage_urgences"><bpmn:incoming>Flux_interne_2_triage_accueil_triage_urgences</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_triage_accueil_triage_urgences" sourceRef="Debut_interne_triage_accueil_triage_urgences" targetRef="Etapes_internes_triage_accueil_triage_urgences" />
      <bpmn:sequenceFlow id="Flux_interne_2_triage_accueil_triage_urgences" sourceRef="Etapes_internes_triage_accueil_triage_urgences" targetRef="Fin_interne_triage_accueil_triage_urgences" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="gravite_accueil_triage_urgences" name="Priorité rouge ?">
      <bpmn:incoming>Flux_6_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_7_accueil_triage_urgences</bpmn:outgoing>
      <bpmn:outgoing>Flux_8_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="alerte_accueil_triage_urgences" name="Déclencher l’alerte vitale">
      <bpmn:incoming>Flux_7_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_11_accueil_triage_urgences</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_alerte_accueil_triage_urgences"><bpmn:outgoing>Flux_interne_1_alerte_accueil_triage_urgences</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_alerte_accueil_triage_urgences" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_alerte_accueil_triage_urgences</bpmn:incoming><bpmn:outgoing>Flux_interne_2_alerte_accueil_triage_urgences</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_alerte_accueil_triage_urgences"><bpmn:incoming>Flux_interne_2_alerte_accueil_triage_urgences</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_alerte_accueil_triage_urgences" sourceRef="Debut_interne_alerte_accueil_triage_urgences" targetRef="Etapes_internes_alerte_accueil_triage_urgences" />
      <bpmn:sequenceFlow id="Flux_interne_2_alerte_accueil_triage_urgences" sourceRef="Etapes_internes_alerte_accueil_triage_urgences" targetRef="Fin_interne_alerte_accueil_triage_urgences" />
    </bpmn:subProcess>
    <bpmn:userTask id="orienter_accueil_triage_urgences" name="Attribuer une filière de soins">
      <bpmn:incoming>Flux_8_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_9_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="attente_accueil_triage_urgences" name="Délai de réévaluation">
      <bpmn:incoming>Flux_9_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_10_accueil_triage_urgences</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_temps_attente_accueil_triage_urgences" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="transmettre_accueil_triage_urgences" name="Transmettre au secteur clinique">
      <bpmn:incoming>Flux_10_accueil_triage_urgences</bpmn:incoming>
      <bpmn:incoming>Flux_11_accueil_triage_urgences</bpmn:incoming>
      <bpmn:outgoing>Flux_12_accueil_triage_urgences</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fin_accueil_triage_urgences" name="Triage terminé">
      <bpmn:incoming>Flux_12_accueil_triage_urgences</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_accueil_triage_urgences" sourceRef="debut_accueil_triage_urgences" targetRef="enregistrer_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_2_accueil_triage_urgences" sourceRef="enregistrer_accueil_triage_urgences" targetRef="constantes_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_3_accueil_triage_urgences" name="Exception" sourceRef="identite_accueil_triage_urgences" targetRef="provisoire_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_4_accueil_triage_urgences" sourceRef="provisoire_accueil_triage_urgences" targetRef="constantes_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_5_accueil_triage_urgences" sourceRef="constantes_accueil_triage_urgences" targetRef="triage_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_6_accueil_triage_urgences" sourceRef="triage_accueil_triage_urgences" targetRef="gravite_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_7_accueil_triage_urgences" name="Oui" sourceRef="gravite_accueil_triage_urgences" targetRef="alerte_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_8_accueil_triage_urgences" name="Non" sourceRef="gravite_accueil_triage_urgences" targetRef="orienter_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_9_accueil_triage_urgences" sourceRef="orienter_accueil_triage_urgences" targetRef="attente_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_10_accueil_triage_urgences" sourceRef="attente_accueil_triage_urgences" targetRef="transmettre_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_11_accueil_triage_urgences" sourceRef="alerte_accueil_triage_urgences" targetRef="transmettre_accueil_triage_urgences" />
    <bpmn:sequenceFlow id="Flux_12_accueil_triage_urgences" sourceRef="transmettre_accueil_triage_urgences" targetRef="fin_accueil_triage_urgences" />
    <bpmn:dataObject id="Objet_fiche_triage_accueil_triage_urgences" />
    <bpmn:dataObjectReference id="Document_fiche_triage_accueil_triage_urgences" name="Fiche de triage et constantes" dataObjectRef="Objet_fiche_triage_accueil_triage_urgences" />
    <bpmn:association id="Association_fiche_triage_accueil_triage_urgences" sourceRef="Document_fiche_triage_accueil_triage_urgences" targetRef="triage_accueil_triage_urgences" associationDirection="One" />
  </bpmn:process>
