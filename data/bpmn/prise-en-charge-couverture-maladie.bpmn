<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_prise_en_charge_couverture_maladie" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_prise_en_charge_couverture_maladie" name="Message métier" />
  <bpmn:error id="Erreur_prise_en_charge_couverture_maladie" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_prise_en_charge_couverture_maladie" name="Gestion de la couverture maladie" isExecutable="false">
    <bpmn:documentation>Vérifier les droits et constituer le dossier de prise en charge selon la couverture présentée par le patient. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_prise_en_charge_couverture_maladie">
      <bpmn:lane id="Couloir_1_prise_en_charge_couverture_maladie" name="Patient / accompagnant">
        <bpmn:flowNodeRef>debut_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_prise_en_charge_couverture_maladie" name="Admissions / caisse">
        <bpmn:flowNodeRef>identifier_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifier_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>indisponible_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manuel_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accord_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enregistrer_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_prise_en_charge_couverture_maladie" name="Organisme payeur / service social">
        <bpmn:flowNodeRef>demander_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reponse_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepte_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>social_prise_en_charge_couverture_maladie</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_prise_en_charge_couverture_maladie" name="Couverture présentée">
      <bpmn:outgoing>Flux_1_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="identifier_prise_en_charge_couverture_maladie" name="Identifier le régime et les pièces">
      <bpmn:incoming>Flux_1_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_2_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="verifier_prise_en_charge_couverture_maladie" name="Vérifier les droits">
      <bpmn:incoming>Flux_2_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_3_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="indisponible_prise_en_charge_couverture_maladie" name="Service de vérification indisponible" attachedToRef="verifier_prise_en_charge_couverture_maladie" cancelActivity="true">
      <bpmn:outgoing>Flux_4_prise_en_charge_couverture_maladie</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_indisponible_prise_en_charge_couverture_maladie" errorRef="Erreur_prise_en_charge_couverture_maladie" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="manuel_prise_en_charge_couverture_maladie" name="Appliquer le contrôle manuel">
      <bpmn:incoming>Flux_4_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_5_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="accord_prise_en_charge_couverture_maladie" name="Accord requis ?">
      <bpmn:incoming>Flux_3_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:incoming>Flux_5_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_6_prise_en_charge_couverture_maladie</bpmn:outgoing>
      <bpmn:outgoing>Flux_7_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="demander_prise_en_charge_couverture_maladie" name="Constituer et transmettre la demande">
      <bpmn:incoming>Flux_6_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_8_prise_en_charge_couverture_maladie</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_demander_prise_en_charge_couverture_maladie"><bpmn:outgoing>Flux_interne_1_demander_prise_en_charge_couverture_maladie</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_demander_prise_en_charge_couverture_maladie" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_demander_prise_en_charge_couverture_maladie</bpmn:incoming><bpmn:outgoing>Flux_interne_2_demander_prise_en_charge_couverture_maladie</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_demander_prise_en_charge_couverture_maladie"><bpmn:incoming>Flux_interne_2_demander_prise_en_charge_couverture_maladie</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_demander_prise_en_charge_couverture_maladie" sourceRef="Debut_interne_demander_prise_en_charge_couverture_maladie" targetRef="Etapes_internes_demander_prise_en_charge_couverture_maladie" />
      <bpmn:sequenceFlow id="Flux_interne_2_demander_prise_en_charge_couverture_maladie" sourceRef="Etapes_internes_demander_prise_en_charge_couverture_maladie" targetRef="Fin_interne_demander_prise_en_charge_couverture_maladie" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="reponse_prise_en_charge_couverture_maladie" name="Réponse de prise en charge">
      <bpmn:incoming>Flux_8_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_9_prise_en_charge_couverture_maladie</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_reponse_prise_en_charge_couverture_maladie" messageRef="Message_prise_en_charge_couverture_maladie" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="accepte_prise_en_charge_couverture_maladie" name="Accord obtenu ?">
      <bpmn:incoming>Flux_9_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_10_prise_en_charge_couverture_maladie</bpmn:outgoing>
      <bpmn:outgoing>Flux_11_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="enregistrer_prise_en_charge_couverture_maladie" name="Enregistrer la couverture">
      <bpmn:incoming>Flux_7_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:incoming>Flux_10_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_12_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="social_prise_en_charge_couverture_maladie" name="Orienter vers caisse ou service social">
      <bpmn:incoming>Flux_11_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:outgoing>Flux_13_prise_en_charge_couverture_maladie</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fin_prise_en_charge_couverture_maladie" name="Modalités communiquées">
      <bpmn:incoming>Flux_12_prise_en_charge_couverture_maladie</bpmn:incoming>
      <bpmn:incoming>Flux_13_prise_en_charge_couverture_maladie</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_prise_en_charge_couverture_maladie" sourceRef="debut_prise_en_charge_couverture_maladie" targetRef="identifier_prise_en_charge_couverture_maladie" />
    <bpmn:sequenceFlow id="Flux_2_prise_en_charge_couverture_maladie" sourceRef="identifier_prise_en_charge_couverture_maladie" targetRef="verifier_prise_en_charge_couverture_maladie" />
