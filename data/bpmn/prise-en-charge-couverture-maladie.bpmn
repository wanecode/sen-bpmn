    <bpmn:sequenceFlow id="Flux_7_prise_en_charge_couverture_maladie" name="Non" sourceRef="accord_prise_en_charge_couverture_maladie" targetRef="enregistrer_prise_en_charge_couverture_maladie" />
    <bpmn:sequenceFlow id="Flux_8_prise_en_charge_couverture_maladie" sourceRef="demander_prise_en_charge_couverture_maladie" targetRef="reponse_prise_en_charge_couverture_maladie" />
    <bpmn:sequenceFlow id="Flux_9_prise_en_charge_couverture_maladie" sourceRef="reponse_prise_en_charge_couverture_maladie" targetRef="accepte_prise_en_charge_couverture_maladie" />
    <bpmn:sequenceFlow id="Flux_10_prise_en_charge_couverture_maladie" name="Oui" sourceRef="accepte_prise_en_charge_couverture_maladie" targetRef="enregistrer_prise_en_charge_couverture_maladie" />
