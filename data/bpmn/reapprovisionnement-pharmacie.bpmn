      <bpmndi:BPMNShape id="Forme_besoin_reapprovisionnement_pharmacie" bpmnElement="besoin_reapprovisionnement_pharmacie" isMarkerVisible="true"><dc:Bounds x="420" y="108" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_commander_reapprovisionnement_pharmacie" bpmnElement="commander_reapprovisionnement_pharmacie"><dc:Bounds x="600" y="323" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_livraison_reapprovisionnement_pharmacie" bpmnElement="livraison_reapprovisionnement_pharmacie"><dc:Bounds x="780" y="336" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_retard_reapprovisionnement_pharmacie" bpmnElement="retard_reapprovisionnement_pharmacie"><dc:Bounds x="722" y="382" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_relancer_reapprovisionnement_pharmacie" bpmnElement="relancer_reapprovisionnement_pharmacie"><dc:Bounds x="960" y="323" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_reception_reapprovisionnement_pharmacie" bpmnElement="reception_reapprovisionnement_pharmacie" isExpanded="false"><dc:Bounds x="960" y="538" width="150" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_nonconforme_reapprovisionnement_pharmacie" bpmnElement="nonconforme_reapprovisionnement_pharmacie"><dc:Bounds x="1092" y="609" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_reserve_reapprovisionnement_pharmacie" bpmnElement="reserve_reapprovisionnement_pharmacie"><dc:Bounds x="1140" y="323" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_ranger_reapprovisionnement_pharmacie" bpmnElement="ranger_reapprovisionnement_pharmacie"><dc:Bounds x="1320" y="103" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_fin_reapprovisionnement_pharmacie" bpmnElement="fin_reapprovisionnement_pharmacie"><dc:Bounds x="1500" y="116" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_Document_bon_commande_reapprovisionnement_pharmacie" bpmnElement="Document_bon_commande_reapprovisionnement_pharmacie"><dc:Bounds x="720" y="409" width="36" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_Document_fiche_stock_reapprovisionnement_pharmacie" bpmnElement="Document_fiche_stock_reapprovisionnement_pharmacie"><dc:Bounds x="1440" y="189" width="36" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Arete_Flux_1_reapprovisionnement_pharmacie" bpmnElement="Flux_1_reapprovisionnement_pharmacie"><di:waypoint x="96" y="134" /><di:waypoint x="168" y="134" /><di:waypoint x="168" y="140" /><di:waypoint x="240" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_2_reapprovisionnement_pharmacie" bpmnElement="Flux_2_reapprovisionnement_pharmacie"><di:waypoint x="380" y="140" /><di:waypoint x="400" y="140" /><di:waypoint x="400" y="133" /><di:waypoint x="420" y="133" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_3_reapprovisionnement_pharmacie" bpmnElement="Flux_3_reapprovisionnement_pharmacie"><di:waypoint x="470" y="133" /><di:waypoint x="535" y="133" /><di:waypoint x="535" y="360" /><di:waypoint x="600" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="88" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_4_reapprovisionnement_pharmacie" bpmnElement="Flux_4_reapprovisionnement_pharmacie"><di:waypoint x="470" y="133" /><di:waypoint x="1500" y="134" /><bpmndi:BPMNLabel><dc:Bounds x="960" y="88" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_5_reapprovisionnement_pharmacie" bpmnElement="Flux_5_reapprovisionnement_pharmacie"><di:waypoint x="740" y="360" /><di:waypoint x="760" y="360" /><di:waypoint x="760" y="354" /><di:waypoint x="780" y="354" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_6_reapprovisionnement_pharmacie" bpmnElement="Flux_6_reapprovisionnement_pharmacie"><di:waypoint x="752" y="397" /><di:waypoint x="856" y="397" /><di:waypoint x="856" y="360" /><di:waypoint x="960" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="841" y="303" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_7_reapprovisionnement_pharmacie" bpmnElement="Flux_7_reapprovisionnement_pharmacie"><di:waypoint x="1100" y="360" /><di:waypoint x="1128" y="360" /><di:waypoint x="1128" y="431" /><di:waypoint x="752" y="431" /><di:waypoint x="752" y="354" /><di:waypoint x="780" y="354" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_8_reapprovisionnement_pharmacie" bpmnElement="Flux_8_reapprovisionnement_pharmacie"><di:waypoint x="816" y="354" /><di:waypoint x="888" y="354" /><di:waypoint x="888" y="581" /><di:waypoint x="960" y="581" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_9_reapprovisionnement_pharmacie" bpmnElement="Flux_9_reapprovisionnement_pharmacie"><di:waypoint x="1122" y="624" /><di:waypoint x="1131" y="624" /><di:waypoint x="1131" y="360" /><di:waypoint x="1140" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="1116" y="303" width="70" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_10_reapprovisionnement_pharmacie" bpmnElement="Flux_10_reapprovisionnement_pharmacie"><di:waypoint x="1280" y="360" /><di:waypoint x="1390" y="360" /><di:waypoint x="1390" y="134" /><di:waypoint x="1500" y="134" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_11_reapprovisionnement_pharmacie" bpmnElement="Flux_11_reapprovisionnement_pharmacie"><di:waypoint x="1110" y="581" /><di:waypoint x="1215" y="581" /><di:waypoint x="1215" y="140" /><di:waypoint x="1320" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Flux_12_reapprovisionnement_pharmacie" bpmnElement="Flux_12_reapprovisionnement_pharmacie"><di:waypoint x="1460" y="140" /><di:waypoint x="1480" y="140" /><di:waypoint x="1480" y="134" /><di:waypoint x="1500" y="134" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Association_bon_commande_reapprovisionnement_pharmacie" bpmnElement="Association_bon_commande_reapprovisionnement_pharmacie"><di:waypoint x="738" y="433" /><di:waypoint x="670" y="397" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Arete_Association_fiche_stock_reapprovisionnement_pharmacie" bpmnElement="Association_fiche_stock_reapprovisionnement_pharmacie"><di:waypoint x="1458" y="213" /><di:waypoint x="1390" y="177" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
