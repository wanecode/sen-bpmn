<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reference_contre_reference" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_reference_contre_reference" name="Message métier" />
  <bpmn:error id="Erreur_reference_contre_reference" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_reference_contre_reference" name="Référence et contre-référence du patient" isExecutable="false">
    <bpmn:documentation>Assurer une orientation documentée entre structures de santé et le retour d’information au professionnel référent. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_reference_contre_reference">
      <bpmn:lane id="Couloir_1_reference_contre_reference" name="Structure référente">
        <bpmn:flowNodeRef>debut_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stabiliser_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dossier_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contre_ref_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_reference_contre_reference</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_reference_contre_reference" name="Coordination / transport">
        <bpmn:flowNodeRef>contacter_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reponse_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refus_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alternative_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepte_reference_contre_reference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transport_reference_contre_reference</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_reference_contre_reference" name="Structure receveuse">
        <bpmn:flowNodeRef>recevoir_reference_contre_reference</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_reference_contre_reference" name="Besoin de référence identifié">
      <bpmn:outgoing>Flux_1_reference_contre_reference</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="stabiliser_reference_contre_reference" name="Stabiliser avant transfert">
      <bpmn:incoming>Flux_1_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_2_reference_contre_reference</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_stabiliser_reference_contre_reference"><bpmn:outgoing>Flux_interne_1_stabiliser_reference_contre_reference</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_stabiliser_reference_contre_reference" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_stabiliser_reference_contre_reference</bpmn:incoming><bpmn:outgoing>Flux_interne_2_stabiliser_reference_contre_reference</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_stabiliser_reference_contre_reference"><bpmn:incoming>Flux_interne_2_stabiliser_reference_contre_reference</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_stabiliser_reference_contre_reference" sourceRef="Debut_interne_stabiliser_reference_contre_reference" targetRef="Etapes_internes_stabiliser_reference_contre_reference" />
      <bpmn:sequenceFlow id="Flux_interne_2_stabiliser_reference_contre_reference" sourceRef="Etapes_internes_stabiliser_reference_contre_reference" targetRef="Fin_interne_stabiliser_reference_contre_reference" />
    </bpmn:subProcess>
    <bpmn:userTask id="dossier_reference_contre_reference" name="Constituer le dossier de référence">
      <bpmn:incoming>Flux_2_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_3_reference_contre_reference</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="contacter_reference_contre_reference" name="Contacter la structure receveuse">
      <bpmn:incoming>Flux_3_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_4_reference_contre_reference</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="reponse_reference_contre_reference" name="Réponse reçue">
      <bpmn:incoming>Flux_4_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_5_reference_contre_reference</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_reponse_reference_contre_reference" messageRef="Message_reference_contre_reference" />
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="refus_reference_contre_reference" name="Absence de réponse" attachedToRef="contacter_reference_contre_reference" cancelActivity="true">
      <bpmn:outgoing>Flux_6_reference_contre_reference</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_temps_refus_reference_contre_reference" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="alternative_reference_contre_reference" name="Chercher une structure alternative">
      <bpmn:incoming>Flux_6_reference_contre_reference</bpmn:incoming>
      <bpmn:incoming>Flux_9_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_7_reference_contre_reference</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="accepte_reference_contre_reference" name="Transfert accepté ?">
      <bpmn:incoming>Flux_5_reference_contre_reference</bpmn:incoming>
      <bpmn:incoming>Flux_7_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_8_reference_contre_reference</bpmn:outgoing>
      <bpmn:outgoing>Flux_9_reference_contre_reference</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="transport_reference_contre_reference" name="Organiser le transport sécurisé">
      <bpmn:incoming>Flux_8_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_10_reference_contre_reference</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_transport_reference_contre_reference"><bpmn:outgoing>Flux_interne_1_transport_reference_contre_reference</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_transport_reference_contre_reference" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_transport_reference_contre_reference</bpmn:incoming><bpmn:outgoing>Flux_interne_2_transport_reference_contre_reference</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_transport_reference_contre_reference"><bpmn:incoming>Flux_interne_2_transport_reference_contre_reference</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_transport_reference_contre_reference" sourceRef="Debut_interne_transport_reference_contre_reference" targetRef="Etapes_internes_transport_reference_contre_reference" />
      <bpmn:sequenceFlow id="Flux_interne_2_transport_reference_contre_reference" sourceRef="Etapes_internes_transport_reference_contre_reference" targetRef="Fin_interne_transport_reference_contre_reference" />
    </bpmn:subProcess>
    <bpmn:userTask id="recevoir_reference_contre_reference" name="Accueillir et prendre en charge">
      <bpmn:incoming>Flux_10_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_11_reference_contre_reference</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="contre_ref_reference_contre_reference" name="Contre-référence transmise">
      <bpmn:incoming>Flux_11_reference_contre_reference</bpmn:incoming>
      <bpmn:outgoing>Flux_12_reference_contre_reference</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_contre_ref_reference_contre_reference" messageRef="Message_reference_contre_reference" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="fin_reference_contre_reference" name="Boucle de référence close">
      <bpmn:incoming>Flux_12_reference_contre_reference</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_reference_contre_reference" sourceRef="debut_reference_contre_reference" targetRef="stabiliser_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_2_reference_contre_reference" sourceRef="stabiliser_reference_contre_reference" targetRef="dossier_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_3_reference_contre_reference" sourceRef="dossier_reference_contre_reference" targetRef="contacter_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_4_reference_contre_reference" sourceRef="contacter_reference_contre_reference" targetRef="reponse_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_5_reference_contre_reference" sourceRef="reponse_reference_contre_reference" targetRef="accepte_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_6_reference_contre_reference" name="Exception" sourceRef="refus_reference_contre_reference" targetRef="alternative_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_7_reference_contre_reference" sourceRef="alternative_reference_contre_reference" targetRef="accepte_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_8_reference_contre_reference" name="Oui" sourceRef="accepte_reference_contre_reference" targetRef="transport_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_9_reference_contre_reference" name="Non" sourceRef="accepte_reference_contre_reference" targetRef="alternative_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_10_reference_contre_reference" sourceRef="transport_reference_contre_reference" targetRef="recevoir_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_11_reference_contre_reference" sourceRef="recevoir_reference_contre_reference" targetRef="contre_ref_reference_contre_reference" />
    <bpmn:sequenceFlow id="Flux_12_reference_contre_reference" sourceRef="contre_ref_reference_contre_reference" targetRef="fin_reference_contre_reference" />
    <bpmn:dataObject id="Objet_fiche_ref_reference_contre_reference" />
    <bpmn:dataObjectReference id="Document_fiche_ref_reference_contre_reference" name="Fiche de référence" dataObjectRef="Objet_fiche_ref_reference_contre_reference" />
    <bpmn:association id="Association_fiche_ref_reference_contre_reference" sourceRef="Document_fiche_ref_reference_contre_reference" targetRef="dossier_reference_contre_reference" associationDirection="One" />
    <bpmn:dataObject id="Objet_fiche_contre_reference_contre_reference" />
    <bpmn:dataObjectReference id="Document_fiche_contre_reference_contre_reference" name="Fiche de contre-référence" dataObjectRef="Objet_fiche_contre_reference_contre_reference" />
    <bpmn:association id="Association_fiche_contre_reference_contre_reference" sourceRef="Document_fiche_contre_reference_contre_reference" targetRef="contre_ref_reference_contre_reference" associationDirection="One" />
  </bpmn:process>
