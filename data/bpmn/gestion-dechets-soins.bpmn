      <bpmndi:BPMNShape id="Forme_securiser_gestion_dechets_soins" bpmnElement="securiser_gestion_dechets_soins"><dc:Bounds x="1140" y="323" width="140" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_traiter_gestion_dechets_soins" bpmnElement="traiter_gestion_dechets_soins"><dc:Bounds x="1320" y="556" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_tracer_gestion_dechets_soins" bpmnElement="tracer_gestion_dechets_soins"><dc:Bounds x="1500" y="323" width="140" height="74" /></bpmndi:BPMNShape>
