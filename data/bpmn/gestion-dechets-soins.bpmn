      <bpmndi:BPMNShape id="Forme_Couloir_1_gestion_dechets_soins" bpmnElement="Couloir_1_gestion_dechets_soins" isHorizontal="true"><dc:Bounds x="20" y="30" width="1990" height="220" /></bpmndi:BPMNShape>
