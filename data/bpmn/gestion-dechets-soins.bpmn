      <bpmndi:BPMNShape id="Forme_aes_gestion_dechets_soins" bpmnElement="aes_gestion_dechets_soins" isExpanded="false"><dc:Bounds x="780" y="318" width="150" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Forme_collecte_gestion_dechets_soins" bpmnElement="collecte_gestion_dechets_soins" isExpanded="false"><dc:Bounds x="960" y="318" width="150" height="86" /></bpmndi:BPMNShape>
