<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_gestion_dechets_soins" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_gestion_dechets_soins" name="Message métier" />
  <bpmn:error id="Erreur_gestion_dechets_soins" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_gestion_dechets_soins" name="Gestion des déchets d’activités de soins" isExecutable="false">
    <bpmn:documentation>Trier, conditionner, collecter et évacuer les déchets de soins selon leur niveau de risque. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_gestion_dechets_soins">
      <bpmn:lane id="Couloir_1_gestion_dechets_soins" name="Producteur du déchet">
        <bpmn:flowNodeRef>debut_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identifier_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dasri_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordinaire_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fermer_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>piquant_gestion_dechets_soins</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_gestion_dechets_soins" name="Agent d’hygiène / stockage">
        <bpmn:flowNodeRef>aes_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collecte_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retard_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>securiser_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tracer_gestion_dechets_soins</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_gestion_dechets_soins" name="Prestataire de traitement">
        <bpmn:flowNodeRef>traiter_gestion_dechets_soins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_gestion_dechets_soins</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_gestion_dechets_soins" name="Déchet produit">
      <bpmn:outgoing>Flux_1_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="identifier_gestion_dechets_soins" name="Déchet à risque ?">
      <bpmn:incoming>Flux_1_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_2_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:outgoing>Flux_3_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="dasri_gestion_dechets_soins" name="Trier dans le contenant sécurisé">
      <bpmn:incoming>Flux_2_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_4_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="ordinaire_gestion_dechets_soins" name="Trier dans la filière assimilée">
      <bpmn:incoming>Flux_3_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_5_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="fermer_gestion_dechets_soins" name="Fermer, étiqueter et peser">
      <bpmn:incoming>Flux_4_gestion_dechets_soins</bpmn:incoming>
      <bpmn:incoming>Flux_5_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_8_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="piquant_gestion_dechets_soins" name="Accident d’exposition" attachedToRef="fermer_gestion_dechets_soins" cancelActivity="true">
      <bpmn:outgoing>Flux_6_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_piquant_gestion_dechets_soins" errorRef="Erreur_gestion_dechets_soins" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="aes_gestion_dechets_soins" name="Appliquer la conduite à tenir AES">
      <bpmn:incoming>Flux_6_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_7_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_aes_gestion_dechets_soins"><bpmn:outgoing>Flux_interne_1_aes_gestion_dechets_soins</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_aes_gestion_dechets_soins" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_aes_gestion_dechets_soins</bpmn:incoming><bpmn:outgoing>Flux_interne_2_aes_gestion_dechets_soins</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_aes_gestion_dechets_soins"><bpmn:incoming>Flux_interne_2_aes_gestion_dechets_soins</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_aes_gestion_dechets_soins" sourceRef="Debut_interne_aes_gestion_dechets_soins" targetRef="Etapes_internes_aes_gestion_dechets_soins" />
      <bpmn:sequenceFlow id="Flux_interne_2_aes_gestion_dechets_soins" sourceRef="Etapes_internes_aes_gestion_dechets_soins" targetRef="Fin_interne_aes_gestion_dechets_soins" />
    </bpmn:subProcess>
    <bpmn:subProcess id="collecte_gestion_dechets_soins" name="Collecter et stocker temporairement">
      <bpmn:incoming>Flux_7_gestion_dechets_soins</bpmn:incoming>
      <bpmn:incoming>Flux_8_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_11_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_collecte_gestion_dechets_soins"><bpmn:outgoing>Flux_interne_1_collecte_gestion_dechets_soins</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_collecte_gestion_dechets_soins" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_collecte_gestion_dechets_soins</bpmn:incoming><bpmn:outgoing>Flux_interne_2_collecte_gestion_dechets_soins</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_collecte_gestion_dechets_soins"><bpmn:incoming>Flux_interne_2_collecte_gestion_dechets_soins</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_collecte_gestion_dechets_soins" sourceRef="Debut_interne_collecte_gestion_dechets_soins" targetRef="Etapes_internes_collecte_gestion_dechets_soins" />
      <bpmn:sequenceFlow id="Flux_interne_2_collecte_gestion_dechets_soins" sourceRef="Etapes_internes_collecte_gestion_dechets_soins" targetRef="Fin_interne_collecte_gestion_dechets_soins" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="retard_gestion_dechets_soins" name="Collecte externe retardée" attachedToRef="collecte_gestion_dechets_soins" cancelActivity="true">
      <bpmn:outgoing>Flux_9_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_temps_retard_gestion_dechets_soins" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="securiser_gestion_dechets_soins" name="Sécuriser la zone et alerter">
      <bpmn:incoming>Flux_9_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_10_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="traiter_gestion_dechets_soins" name="Prise en charge par la filière">
      <bpmn:incoming>Flux_10_gestion_dechets_soins</bpmn:incoming>
      <bpmn:incoming>Flux_11_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_12_gestion_dechets_soins</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_traiter_gestion_dechets_soins" messageRef="Message_gestion_dechets_soins" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="tracer_gestion_dechets_soins" name="Tracer poids et élimination">
      <bpmn:incoming>Flux_12_gestion_dechets_soins</bpmn:incoming>
      <bpmn:outgoing>Flux_13_gestion_dechets_soins</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fin_gestion_dechets_soins" name="Déchet éliminé">
      <bpmn:incoming>Flux_13_gestion_dechets_soins</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_gestion_dechets_soins" sourceRef="debut_gestion_dechets_soins" targetRef="identifier_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_2_gestion_dechets_soins" name="Oui" sourceRef="identifier_gestion_dechets_soins" targetRef="dasri_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_3_gestion_dechets_soins" name="Non" sourceRef="identifier_gestion_dechets_soins" targetRef="ordinaire_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_4_gestion_dechets_soins" sourceRef="dasri_gestion_dechets_soins" targetRef="fermer_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_5_gestion_dechets_soins" sourceRef="ordinaire_gestion_dechets_soins" targetRef="fermer_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_6_gestion_dechets_soins" name="Exception" sourceRef="piquant_gestion_dechets_soins" targetRef="aes_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_7_gestion_dechets_soins" sourceRef="aes_gestion_dechets_soins" targetRef="collecte_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_8_gestion_dechets_soins" sourceRef="fermer_gestion_dechets_soins" targetRef="collecte_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_9_gestion_dechets_soins" name="Exception" sourceRef="retard_gestion_dechets_soins" targetRef="securiser_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_10_gestion_dechets_soins" sourceRef="securiser_gestion_dechets_soins" targetRef="traiter_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_11_gestion_dechets_soins" sourceRef="collecte_gestion_dechets_soins" targetRef="traiter_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_12_gestion_dechets_soins" sourceRef="traiter_gestion_dechets_soins" targetRef="tracer_gestion_dechets_soins" />
    <bpmn:sequenceFlow id="Flux_13_gestion_dechets_soins" sourceRef="tracer_gestion_dechets_soins" targetRef="fin_gestion_dechets_soins" />
    <bpmn:dataObject id="Objet_bordereau_gestion_dechets_soins" />
    <bpmn:dataObjectReference id="Document_bordereau_gestion_dechets_soins" name="Bordereau de collecte et d’élimination" dataObjectRef="Objet_bordereau_gestion_dechets_soins" />
    <bpmn:association id="Association_bordereau_gestion_dechets_soins" sourceRef="Document_bordereau_gestion_dechets_soins" targetRef="tracer_gestion_dechets_soins" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagramme_gestion_dechets_soins">
