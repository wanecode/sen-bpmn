<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_gestion_dossier_medical" targetNamespace="https://sen-bpmn.org/processus">
  <bpmn:message id="Message_gestion_dossier_medical" name="Message métier" />
  <bpmn:error id="Erreur_gestion_dossier_medical" name="Exception de processus" errorCode="EXCEPTION" />
  <bpmn:process id="Processus_gestion_dossier_medical" name="Gestion du dossier médical" isExecutable="false">
    <bpmn:documentation>Créer, alimenter, rendre disponible et archiver le dossier dans le respect de la confidentialité. Révision du modèle : 2.0.</bpmn:documentation>
    <bpmn:laneSet id="Ensemble_couloirs_gestion_dossier_medical">
      <bpmn:lane id="Couloir_1_gestion_dossier_medical" name="Professionnel de santé">
        <bpmn:flowNodeRef>debut_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>classer_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>relancer_gestion_dossier_medical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_2_gestion_dossier_medical" name="Archives médicales">
        <bpmn:flowNodeRef>indexer_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erreur_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completude_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complet_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archiver_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demande_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_gestion_dossier_medical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Couloir_3_gestion_dossier_medical" name="Référent confidentialité">
        <bpmn:flowNodeRef>bloquer_gestion_dossier_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruire_gestion_dossier_medical</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="debut_gestion_dossier_medical" name="Document clinique produit">
      <bpmn:outgoing>Flux_1_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="classer_gestion_dossier_medical" name="Identifier et classer la pièce">
      <bpmn:incoming>Flux_1_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_2_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="indexer_gestion_dossier_medical" name="Indexer dans le dossier patient">
      <bpmn:incoming>Flux_2_gestion_dossier_medical</bpmn:incoming>
      <bpmn:incoming>Flux_4_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_5_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="erreur_gestion_dossier_medical" name="Mauvais dossier suspecté" attachedToRef="indexer_gestion_dossier_medical" cancelActivity="true">
      <bpmn:outgoing>Flux_3_gestion_dossier_medical</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_erreur_gestion_dossier_medical" errorRef="Erreur_gestion_dossier_medical" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="bloquer_gestion_dossier_medical" name="Bloquer l’accès et corriger l’identité">
      <bpmn:incoming>Flux_3_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_4_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="completude_gestion_dossier_medical" name="Contrôler complétude et signatures">
      <bpmn:incoming>Flux_5_gestion_dossier_medical</bpmn:incoming>
      <bpmn:incoming>Flux_8_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_6_gestion_dossier_medical</bpmn:outgoing>
      <bpmn:startEvent id="Debut_interne_completude_gestion_dossier_medical"><bpmn:outgoing>Flux_interne_1_completude_gestion_dossier_medical</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Etapes_internes_completude_gestion_dossier_medical" name="Exécuter les étapes détaillées"><bpmn:incoming>Flux_interne_1_completude_gestion_dossier_medical</bpmn:incoming><bpmn:outgoing>Flux_interne_2_completude_gestion_dossier_medical</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Fin_interne_completude_gestion_dossier_medical"><bpmn:incoming>Flux_interne_2_completude_gestion_dossier_medical</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_interne_1_completude_gestion_dossier_medical" sourceRef="Debut_interne_completude_gestion_dossier_medical" targetRef="Etapes_internes_completude_gestion_dossier_medical" />
      <bpmn:sequenceFlow id="Flux_interne_2_completude_gestion_dossier_medical" sourceRef="Etapes_internes_completude_gestion_dossier_medical" targetRef="Fin_interne_completude_gestion_dossier_medical" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="complet_gestion_dossier_medical" name="Dossier complet ?">
      <bpmn:incoming>Flux_6_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_7_gestion_dossier_medical</bpmn:outgoing>
      <bpmn:outgoing>Flux_9_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="relancer_gestion_dossier_medical" name="Demande de pièce envoyée">
      <bpmn:incoming>Flux_7_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_8_gestion_dossier_medical</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_message_relancer_gestion_dossier_medical" messageRef="Message_gestion_dossier_medical" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="archiver_gestion_dossier_medical" name="Archiver selon la durée définie">
      <bpmn:incoming>Flux_9_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_12_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="demande_gestion_dossier_medical" name="Demande d’accès non autorisée" attachedToRef="archiver_gestion_dossier_medical" cancelActivity="true">
      <bpmn:outgoing>Flux_10_gestion_dossier_medical</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definition_erreur_demande_gestion_dossier_medical" errorRef="Erreur_gestion_dossier_medical" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="instruire_gestion_dossier_medical" name="Instruire la demande d’accès">
      <bpmn:incoming>Flux_10_gestion_dossier_medical</bpmn:incoming>
      <bpmn:outgoing>Flux_11_gestion_dossier_medical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fin_gestion_dossier_medical" name="Dossier sécurisé">
      <bpmn:incoming>Flux_11_gestion_dossier_medical</bpmn:incoming>
      <bpmn:incoming>Flux_12_gestion_dossier_medical</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1_gestion_dossier_medical" sourceRef="debut_gestion_dossier_medical" targetRef="classer_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_2_gestion_dossier_medical" sourceRef="classer_gestion_dossier_medical" targetRef="indexer_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_3_gestion_dossier_medical" name="Exception" sourceRef="erreur_gestion_dossier_medical" targetRef="bloquer_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_4_gestion_dossier_medical" sourceRef="bloquer_gestion_dossier_medical" targetRef="indexer_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_5_gestion_dossier_medical" sourceRef="indexer_gestion_dossier_medical" targetRef="completude_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_6_gestion_dossier_medical" sourceRef="completude_gestion_dossier_medical" targetRef="complet_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_7_gestion_dossier_medical" name="Non" sourceRef="complet_gestion_dossier_medical" targetRef="relancer_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_8_gestion_dossier_medical" sourceRef="relancer_gestion_dossier_medical" targetRef="completude_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_9_gestion_dossier_medical" name="Oui" sourceRef="complet_gestion_dossier_medical" targetRef="archiver_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_10_gestion_dossier_medical" name="Exception" sourceRef="demande_gestion_dossier_medical" targetRef="instruire_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_11_gestion_dossier_medical" sourceRef="instruire_gestion_dossier_medical" targetRef="fin_gestion_dossier_medical" />
    <bpmn:sequenceFlow id="Flux_12_gestion_dossier_medical" sourceRef="archiver_gestion_dossier_medical" targetRef="fin_gestion_dossier_medical" />
    <bpmn:dataObject id="Objet_dossier_gestion_dossier_medical" />
    <bpmn:dataObjectReference id="Document_dossier_gestion_dossier_medical" name="Dossier médical et journal d’accès" dataObjectRef="Objet_dossier_gestion_dossier_medical" />
    <bpmn:association id="Association_dossier_gestion_dossier_medical" sourceRef="Document_dossier_gestion_dossier_medical" targetRef="archiver_gestion_dossier_medical" associationDirection="One" />
  </bpmn:process>
