# URL canonique intégrée aux métadonnées et au sitemap pendant le build
SITE_URL=https://processus.example.sn
NEXT_PUBLIC_SITE_URL=https://processus.example.sn

# Domaine résolu vers le serveur Caddy
DOMAIN=processus.example.sn

# Port local de diagnostic ; Caddy communique directement avec app:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1

# Image locale ou publiée sur GitHub Container Registry
SEN_BPMN_IMAGE=ghcr.io/wanecode/sen-bpmn:latest
