# Adresse canonique, sans barre oblique finale
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend du catalogue : statique par défaut, sqlite pour Docker/auto-hébergement
SEN_BPMN_STORAGE=static

# Répertoire persistant de SQLite et emplacement optionnel de la base
SEN_BPMN_DATA_DIR=./data
# SEN_BPMN_DATABASE_PATH=./data/catalogue.sqlite

# Répertoire contenant les fichiers BPMN versionnés
SEN_BPMN_BPMN_DIR=./data/bpmn

# Domaine utilisé par Caddy dans le profil de production Docker
DOMAIN=localhost
